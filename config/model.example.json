{
  "default_profile": "aliyun-qwen",
  "profiles": [
    {
      "id": "aliyun-qwen",
      "label": "Qwen 3.7 Plus",
      "provider": "aliyun-model-studio",
      "api_key": "sk-...",
      "base_url": "https://{workspace_id}.cn-beijing.maas.aliyuncs.com",
      "model": "qwen3.7-plus",
      "timeout_seconds": 90,
      "max_output_tokens": 4096
    },
    {
      "id": "openrouter-deepseek",
      "label": "DeepSeek V4 Flash",
      "provider": "openrouter",
      "api_key": "sk-or-v1-...",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "deepseek/deepseek-v4-flash",
      "timeout_seconds": 90,
      "max_output_tokens": 4096
    },
    {
      "id": "siliconflow-qwen3.5-4b",
      "label": "Qwen 3.5 4B（SiliconFlow）",
      "provider": "siliconflow",
      "api_key_env": "SILICONFLOW_API_KEY",
      "base_url": "https://api.siliconflow.cn",
      "model": "Qwen/Qwen3.5-4B",
      "timeout_seconds": 600,
      "max_output_tokens": 16384,
      "enable_thinking": true,
      "thinking_budget": 128,
      "stream": false,
      "thinking_stages": ["plan", "extract", "synthesize", "judge"]
    }
  ],
  "retrieval": {
    "backend": "lexical",
    "top_k": 8,
    "candidate_budget": 12,
    "max_per_document": 2,
    "max_rounds": 2,
    "refine_on_empty": true,
    "refine_min_candidates": 1,
    "index_path": "data/knowledge.faiss",
    "embedding": {
      "provider": "openai-compatible",
      "api_key_env": "MEDICAL_AGENT_EMBEDDING_API_KEY",
      "base_url": "https://api.openai.com/v1",
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "timeout_seconds": 60,
      "cache_size": 256,
      "cache_ttl_seconds": 600
    },
    "source_policy": {
      "enabled": true,
      "allowed_source_types": ["built_in", "imported", "guideline"],
      "blocked_statuses": ["retracted", "revoked", "unsafe", "poisoned"],
      "min_priority": 0,
      "require_version": true,
      "allow_synthetic": true,
      "max_age_days": 0,
      "reject_unknown_date": false
    }
  },
  "reranker": {
    "enabled": false,
    "provider": "cohere",
    "endpoint": "https://api.example.invalid/rerank",
    "api_key_env": "MEDICAL_AGENT_RERANKER_API_KEY",
    "model": "rerank-model",
    "timeout_seconds": 30,
    "top_n": 8,
    "auth_header": "X-API-Key",
    "max_calls_per_run": 8,
    "min_candidates": 2,
    "cache_size": 128,
    "cache_ttl_seconds": 300
  },
  "routing": {
    "mode": "evidence",
    "provider": "generic",
    "endpoint": "https://api.example.invalid/route",
    "api_key_env": "MEDICAL_AGENT_ROUTER_API_KEY",
    "model": "risk-router-model",
    "timeout_seconds": 30,
    "send_patient_record": false,
    "rules": []
  }
}
